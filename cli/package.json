{
  "name": "@figma/code-connect",
  "version": "2.1.0",
  "description": "A tool for connecting your design system components in code with your design system in Figma",
  "keywords": [],
  "author": "Figma",
  "license": "MIT",
  "main": "./dist/react/index_react.js",
  "exports": {
    ".": {
      "types": "./dist/react/index_react.d.ts",
      "default": "./dist/react/index_react.js"
    },
    "./cli-commands-template": {
      "types": "./dist/commands/connect_template.d.ts",
      "default": "./dist/commands/connect_template.js"
    },
    "./html": {
      "types": "./dist/html/index_html.d.ts",
      "default": "./dist/html/index_html.js"
    },
    "./react": {
      "types": "./dist/react/index_react.d.ts",
      "default": "./dist/react/index_react.js"
    },
    "./figma-types": {
      "types": "./figma-types.d.ts"
    },
    "./figma-types-no-require": {
      "types": "./figma-types-no-require.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figma/code-connect.git"
  },
  "homepage": "https://github.com/figma/code-connect#readme",
  "bin": {
    "figma": "bin/figma"
  },
  "files": [
    "dist/**/*",
    "figma-types.d.ts",
    "figma-types-no-require.d.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc --noCheck",
    "build:web": "pnpm build",
    "build:webpack": "cross-env NODE_OPTIONS=\"--max-old-space-size=8196\" webpack --mode production",
    "test": "npm run test:no-coverage -- --coverage",
    "test:no-coverage": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --no-deprecation --max-old-space-size=10240\" npx jest --logHeapUsage --workerIdleMemoryLimit=1.5G",
    "test:fast": "npm run test -- --testPathIgnorePatterns=template_rendering.test.ts --testPathIgnorePatterns=e2e_parse_command_swift.test.ts",
    "test:compose": "cd ../compose && ./gradlew test",
    "test:all": "npm run test && npm run test:compose",
    "test:ci": "npm run test:non-mac -- --runInBand",
    "test:swift": "npm run test -- --runInBand --testPathPattern=e2e_parse_command_swift.test.ts --testPathPattern=e2e_parse_command_swift_xcodeproj.test.ts",
    "test:non-mac": "npm run test -- --testPathIgnorePatterns=e2e_parse_command_swift.test.ts --testPathIgnorePatterns=e2e_parse_command_swift_xcodeproj.test.ts",
    "bundle": "npm run build && npm pack && mkdir -p bundle && mv figma-code-connect*.tgz bundle",
    "bundle:local": "npm run build && mkdir -p bundle-local && pnpm pack --pack-destination bundle-local",
    "bundle:npm-readme:prepare": "mv README.md ../cli-README.md.bak && cp ../README.md . && npx tsx ../scripts/make_readme_links_absolute.ts",
    "bundle:npm-readme:restore": "mv ../cli-README.md.bak README.md",
    "bundle:npm": "npm run build && npm run bundle:npm-readme:prepare && npm pack && mkdir -p bundle-npm && mv figma-code-connect*.tgz bundle-npm; npm run bundle:npm-readme:restore",
    "publish:npm": "npm install && npm run build && npm run bundle:npm-readme:prepare && npm publish --access public; npm run bundle:npm-readme:restore",
    "typecheck": "tsc --noEmit -p tsconfig-typecheck.json"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/generator": "7.28.5",
    "@babel/parser": "7.28.5",
    "@babel/types": "7.28.5",
    
    
    "@storybook/csf-tools": "8.5.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/jest": "^29.5.13",
    "@types/jsdom": "^21.1.7",
    "@types/lodash": "4.17.20",
    "@types/node": "22.19.21",
    "@types/prettier": "2.7.3",
    "@types/react": "18.3.27",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.1",
    "tsx": "4.21.0",
    "webpack": "5.91.0",
    "webpack-cli": "5.1.4"
  },
  "dependencies": {
    
    
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "compare-versions": "^6.1.0",
    "cross-spawn": "^7.0.3",
    "dotenv": "^16.3.1",
    "esbuild-wasm": "0.27.5",
    "find-up": "^5.0.0",
    "glob": "^11.0.4",
    "jsdom": "^24.1.1",
    "lodash": "4.18.1",
    "minimatch": "^9.0.3",
    "parse5": "^7.1.2",
    "prettier": "^2.8.8",
    "strip-ansi": "^6.0.0",
    "ts-morph": "^27.0.0",
    "typescript": "6.0.3",
    
    "undici": "^7.19.1",
    "zod": "3.25.76",
    "zod-validation-error": "^3.2.0"
  }
}
